/* Global reset */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    }
/* Global page layout */
body{
    font-family: "JetBrains Nerd Font", "JetBrains Mono", "Fira Code", "Courier New", monospace;
    max-width: 900px;
    margin: 60px auto;
    padding: 40px;
    background: #0a1a2f;  /*Navy blue */
    color: #00ff66;    /*Terminal Green*/
    line-height: 1.6;
}
h1, h2, h3 {
    color: #00ff66;
    margin-bottom: 20px;
    font-weight: bold;
}

h1 {
    font-size: 4.0rem;
}
h2 {
    font-size: 1.8rem;
}
h3 {
    font-size: 1.4rem;
}
a {
    color: #6cf;
    text-decoration: none;
    font-weight: bold;
}
a:hover {
    color: #33ff88;
}

.projects {
    display: block;
    padding: 12px 16px;
    margin: 12px 0;
    background: #222;
    border-radius: 6px;
    text-decoration: none;
    color: #6cf;
    font-weight: bold;
    transition: background 0.2s;
}
.projects:hover {
    background: #333;
}

/*Global card style( posts, projects, anything really)*/
.card {
    background: #112544;
    padding: 20px;
    margin: 20px 0;
    border-radius: 8px;
    border-left: 4px solid #00ff66;
}
/*Navigation bar and very good for posts.html page...*/
nav {
    margin-bottom: 40px;
}
nav a {
    margin-right: 20px;
}

 h1 {
    font-size: 3rem;
    margin-bottom: 0.5rem;     
  }  
 h2 {
    font-size: 2rem;
    margin-top: 0.25;
    margin-bottom: 1rem;
 }
/* Hero Box, using to segregate an area with what color I want, maybe*/
.hero-box {
    background: #112544;
    padding: 30px;
    border-radius: 10px;
    border-left: 4px solid #00ff66;
    margin-bottom: 40px;
    text-align: center;
}
.left-text {
    text-align: left;
}

/* Flashy Hero Box Below Will make the bottom. The three .hero structs below
 will add some flare to the text. From top to bottom - Subtle glow, Gradient
  and the last one at the bottom of the three structs listed is animated border glow*/
.hero-box {
    box-shadow: 0 0 20px rgba(0, 255, 102, 0.2);
    background: linear-gradient(135deg, #0a1a2f, #112544);
}

/*
.hero-box {
    animation: glow 2s infinite alternate;
}
@keyframes glow {
    from { border-left-color: #00ff66; }
    to   { border-left-color: #33ff88; }
}
Below will be a block for subtle neon glow on hero box
*/
.hero-box {
    box-shadow: 0 0 20px rgba(0, 255, 102, 0.25);
    animation: glow 2s infinite alternate;
}
/*Animated border glow is this whole keyframe glow and glow hero-box right under*/
@keyframes glow {
    from { border-left-color: #00ff66; }
    to   { border-left-color: #33ff88; }
}
/*This below is for the cMatrix on index/home page*/
.terminal {
    background: #0a1a2f;
    padding: 20px;
    border-radius: 8px;
    font-family: monospace;
    color: #00ff66;
    margin-top: 30px;
}





